PORT=3001
CLIENT_ORIGIN=http://localhost:5173

# Railway: set CLIENT_ORIGIN to your public URL after first deploy, e.g.
# https://your-service.up.railway.app
# (Optional if you only open the app from that same URL.)

# Optional: verify Socket.IO JWTs (same project as the client). Omit for local guest mode without Supabase.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...  # clé « anon » du dashboard — sert aussi à /api/client-env.json (prod)
# SUPABASE_SERVICE_ROLE_KEY=eyJ...  # service_role — never expose to the browser
# Requis pour l’inscription sans e-mail (POST /api/auth/register → auth.admin.createUser).
#
# En production, tu peux à la place réutiliser VITE_SUPABASE_URL + VITE_SUPABASE_ANON_KEY :
# le serveur les renvoie au client au chargement (plus besoin qu’elles soient présentes au build Vite).
