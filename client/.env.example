# Dev only. On Railway/production builds: leave VITE_SOCKET_URL unset so the app uses the site URL.
# Never set VITE_SOCKET_URL=http://localhost:3001 for production builds — the browser would connect to the user's PC, not your server.
VITE_SOCKET_URL=http://localhost:3001
VITE_DEV_PORT=5173

# Supabase (optional). If both are set, the app uses email login instead of the local guest identity.
# Project URL and anon key: Supabase → Project Settings → API
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJ...

# Optional WebRTC ICE servers (JSON array). Add TURN if video fails across strict NATs / mobile:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
